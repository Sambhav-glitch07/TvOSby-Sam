<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_media_root"
    android:layout_width="320dp"
    android:layout_height="180dp"
    android:layout_marginEnd="20dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/glass_panel_card"
    android:padding="2dp">

    <!-- Card Artwork -->
    <ImageView
        android:id="@+id/iv_media_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Poster Art" />

    <!-- Glass Dark Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_vignette_bottom" />

    <!-- Focused Glass Highlight Rim -->
    <View
        android:id="@+id/view_focus_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_card_focused_glow"
        android:visibility="gone" />

    <!-- Content Metadata -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_media_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4K HDR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tv_media_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sample Cinematic Title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/tv_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_media_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sci-Fi • 2h 24m • 2024"
            android:textSize="13sp"
            android:textColor="@color/tv_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</FrameLayout>
