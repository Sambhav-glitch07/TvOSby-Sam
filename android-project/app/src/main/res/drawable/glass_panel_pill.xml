<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#66FFFFFF"
                android:endColor="#2BFFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
            <padding
                android:left="22dp"
                android:top="11dp"
                android:right="22dp"
                android:bottom="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1EFFFFFF"
                android:endColor="#0AFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#2BFFFFFF" />
            <padding
                android:left="22dp"
                android:top="11dp"
                android:right="22dp"
                android:bottom="11dp" />
        </shape>
    </item>
</selector>
