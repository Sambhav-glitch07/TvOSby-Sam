<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_tv_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_obsidian"
    android:descendantFocusability="afterDescendants"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Layer 1: Ambient Backdrop & Dynamic Glow -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Hero Cinematic Backdrop"
        android:alpha="0.45" />

    <View
        android:id="@+id/view_ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#10FFFFFF" />

    <!-- Top & Left Scrim for Text Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_vignette_bottom" />

    <!-- Layer 2: Main TV Vertical Scrolling Workspace -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="100dp"
            android:paddingBottom="80dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hero Featured Showcase Banner -->
            <LinearLayout
                android:id="@+id/layout_hero_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp"
                android:clipChildren="false">

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_hero_badge_network"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAMBHAV ORIGINAL"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="#6B7280" />

                    <TextView
                        android:id="@+id/tv_hero_badge_tech"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4K HDR • DOLBY VISION • ATMOS"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tv_hero_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/glass_panel_pill"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="IMDb 9.1"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Hero Title -->
                <TextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="720dp"
                    android:layout_height="wrap_content"
                    android:text="INTERSTELLAR ODYSSEY"
                    style="@style/TextAppearance.Sambhav.HeroTitle"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Hero Synopsis -->
                <TextView
                    android:id="@+id/tv_hero_synopsis"
                    android:layout_width="640dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="A visionary team of deep-space pioneers navigates the outer edges of a newly discovered wormhole in search of humanity's sanctuary across uncharted celestial realms."
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <!-- Hero Glass Action Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:clipChildren="false">

                    <TextView
                        android:id="@+id/btn_hero_watch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/glass_panel_pill"
                        android:text="Play Now"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/tv_text_primary"
                        android:elevation="4dp" />

                    <TextView
                        android:id="@+id/btn_hero_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/glass_panel_pill"
                        android:text="Preview Trailer"
                        android:textSize="14sp"
                        android:textColor="@color/tv_text_secondary"
                        android:elevation="4dp" />

                    <TextView
                        android:id="@+id/btn_hero_watchlist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/glass_panel_pill"
                        android:text="+ Watchlist"
                        android:textSize="14sp"
                        android:textColor="@color/tv_text_secondary"
                        android:elevation="4dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- SECTION 1: Recently Opened Apps -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quick_launch"
                style="@style/TextAppearance.Sambhav.SectionHeader"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_apps"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="36dp" />

            <!-- SECTION 2: Featured Cinematic Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_featured_cinematic"
                style="@style/TextAppearance.Sambhav.SectionHeader"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_featured_cinematic"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="36dp" />

            <!-- SECTION 3: Television Applications -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_installed_apps"
                style="@style/TextAppearance.Sambhav.SectionHeader"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_installed_apps"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="36dp" />

            <!-- SECTION 4: Sambhav Originals & Shows -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_sambhav_originals"
                style="@style/TextAppearance.Sambhav.SectionHeader"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sambhav_shows"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="36dp" />

            <!-- SECTION 5: TCL Hardware & Inputs -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_settings_tcl"
                style="@style/TextAppearance.Sambhav.SectionHeader"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_hardware_inputs"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Layer 3: Pinned Glass Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:background="#D0080B10">

        <!-- Sambhav Brand Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_sambhav_logo"
                android:contentDescription="Sambhav Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/sambhav_brand"
                style="@style/TextAppearance.Sambhav.Brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="TV OS"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Center Navigation Tabs -->
        <LinearLayout
            android:id="@+id/layout_tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clipChildren="false">

            <TextView
                android:id="@+id/tab_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:background="@drawable/glass_panel_pill"
                android:text="@string/tab_home"
                android:textSize="15sp"
                android:textColor="@color/tv_text_primary" />

            <TextView
                android:id="@+id/tab_movies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:background="@drawable/glass_panel_pill"
                android:text="@string/tab_movies"
                android:textSize="15sp"
                android:textColor="@color/tv_text_secondary" />

            <TextView
                android:id="@+id/tab_shows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:background="@drawable/glass_panel_pill"
                android:text="@string/tab_shows"
                android:textSize="15sp"
                android:textColor="@color/tv_text_secondary" />

            <TextView
                android:id="@+id/tab_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:background="@drawable/glass_panel_pill"
                android:text="@string/tab_apps"
                android:textSize="15sp"
                android:textColor="@color/tv_text_secondary" />

            <TextView
                android:id="@+id/tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:background="@drawable/glass_panel_pill"
                android:text="@string/tab_settings"
                android:textSize="15sp"
                android:textColor="@color/tv_text_secondary" />
        </LinearLayout>

        <!-- Right System Indicators & Clock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_network_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi 5G"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tv_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:45 PM"
                android:textColor="@color/tv_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
